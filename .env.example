# Bu dosyayi .env olarak kopyalayip kendi degerlerinizle doldurun.
# .env dosyasi .gitignore icinde, depoya gonderilmez.

# BotFather'dan aldiginiz bot token'i
TELEGRAM_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Botu kullanabilecek Telegram chat id'leri, virgulle ayirin
IZINLI_KULLANICILAR=111111111,222222222

# Tum kullanicilarin aramalarini gorup iptal edebilecek yoneticiler
ADMIN_KULLANICILAR=111111111
